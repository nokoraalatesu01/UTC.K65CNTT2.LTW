@model Model_Thanh_Vien.Models.Member
<h2>Thêm mới thành viên</h2>
<form asp-action="Create" method="post"> 
    <div class="form-group">
        <label asp-for="Username">Tên đăng nhập</label>
        <input asp-for="Username" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="FullName">Họ và tên</label>
        <input asp-for="FullName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Password">Mật khẩu</label>
        <input asp-for="Password" type="password" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" class="form-control" />
    </div>
<br />
    <button type="submit" class="btn btn-primary">Lưu thành viên</button>
</form>