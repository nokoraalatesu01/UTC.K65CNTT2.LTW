@model NDT_Lesson08.Models.OrderBook

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div>
    <h4>OrderBook</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.OrderId)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.OrderId)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.OrderDate)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.OrderDate)</dd>
        <dt class="col-sm-2">Account</dt>
        <dd class="col-sm-10">@Model.Account?.Username</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ReceiveAddress)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ReceiveAddress)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ReceivePhone)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ReceivePhone)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Status)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="OrderId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>