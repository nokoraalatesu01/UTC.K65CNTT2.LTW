@model IEnumerable<Product>

@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="card">
    <div class="card-header">
        <a asp-action="Create" class="btn btn-success btn-sm"><i class="fas fa-plus"></i> Thêm mới</a>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-bordered text-nowrap">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Hình</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Giá KM</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th style="width:150px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="~/uploads/product/@item.Image" height="40" />
                            }
                        </td>
                        <td>@item.Name</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.Price.ToString("N0")</td>
                        <td>@item.SalePrice.ToString("N0")</td>
                        <td>
                            <span class="badge @(item.Status == 1 ? "badge-success" : "badge-secondary")">
                                @(item.Status == 1 ? "Hiển thị" : "Ẩn")
                            </span>
                        </td>
                        <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm"><i class="fas fa-edit"></i></a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc muốn xóa?');">
                                <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>