@model Product

<input type="hidden" asp-for="Id" />

<div class="form-group">
    <label asp-for="Name">Tên sản phẩm</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="CategoryId">Danh mục</label>
    <select asp-for="CategoryId" asp-items="(SelectList)ViewBag.Categories" class="form-control">
        <option value="0">-- Chọn danh mục --</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 form-group">
        <label asp-for="Price">Giá</label>
        <input asp-for="Price" type="number" step="any" min="0" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-6 form-group">
        <label asp-for="SalePrice">Giá khuyến mãi</label>
        <input asp-for="SalePrice" type="number" step="any" min="0" class="form-control" />
        <span asp-validation-for="SalePrice" class="text-danger"></span>
    </div>
</div>

<div class="form-group">
    <label asp-for="Status">Trạng thái</label>
    <select asp-for="Status" class="form-control">
        <option value="1">Hiển thị</option>
        <option value="0">Ẩn</option>
    </select>
</div>

<div class="form-group">
    <label for="imageFile">Hình ảnh</label>
    <input type="file" name="imageFile" id="imageFile" class="form-control-file" accept="image/*" />
    @Html.ValidationMessage("imageFile", new { @class = "text-danger" })
    @if (!string.IsNullOrEmpty(Model.Image))
    {
        <div class="mt-2">
            <img src="~/uploads/product/@Model.Image" style="max-height:100px" />
        </div>
    }
</div>

<div class="form-group">
    <label asp-for="Description">Mô tả</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>