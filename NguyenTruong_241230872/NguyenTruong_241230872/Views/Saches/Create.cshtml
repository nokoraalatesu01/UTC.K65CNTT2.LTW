@model NguyenTruong_241230872.Models.Sach

@{
    ViewData["Title"] = "Thêm Sách mới";
}

<h1>Nguyễn Đức Trường</h1>

<h4>Thêm sách mới </h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="Post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="MaTl" class="control-label"></label>
                <select asp-for="MaTl" asp-items="ViewBag.DanhSachTL" class="form-control">
                    <option value="">-- Chọn thể loại --</option>
                </select>
                <span asp-validation-for="MaTl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TenSach" class="control-label"></label>
                <input asp-for="TenSach" class="form-control" />
                <span asp-validation-for="TenSach" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Gia" class="control-label"></label>
                <input asp-for="Gia" class="form-control" />
                <span asp-validation-for="Gia" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Anh" class="control-label"></label>
                <input asp-for="Anh" class="form-control" />
                <span asp-validation-for="Anh" class="text-danger"></span>
            </div>

           
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
