<div id="myCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="6000">

    <div class="carousel-indicators">
        <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner" style="max-height:450px; overflow:hidden;">
        <div class="carousel-item active">
            <img src="~/images/slide/sl1.png" class="d-block w-100" style="height:450px; object-fit:cover;" alt="Black Friday">
            <div class="carousel-caption d-none d-md-block">
                <h5>...</h5>

            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/slide/sl2.png" class="d-block w-100" style="height:450px; object-fit:cover;" alt="Slide 2">
            <div class="carousel-caption d-none d-md-block">
                <h5>...</h5>

            </div>
        </div>
        <div class="carousel-item">
            <img src="~/images/slide/sl3.png" class="d-block w-100" style="height:450px; object-fit:cover;" alt="Slide 3">
            <div class="carousel-caption d-none d-md-block">
                <h5>...</h5>

            </div>
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>