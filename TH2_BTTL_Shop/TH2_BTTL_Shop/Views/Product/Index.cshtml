@{
    ViewData["Title"] = "Danh sách sản phẩm";
    List<Category> categories = ViewBag.Categories;
    List<Product> products = ViewBag.Products;
    int? currentCategoryId = ViewBag.CurrentCategoryId;
}

<div class="row">
    <div class="col-md-3">
        <h4>DANH MỤC</h4>
        <div class="list-group mb-4">
            <a asp-route="product-index"
               class="list-group-item list-group-item-action @(currentCategoryId == null ? "active" : "")">
                Tất cả
            </a>
            @foreach (var cate in categories)
            {
                <a asp-route="product-index" asp-route-categoryId="@cate.Id"
                   class="list-group-item list-group-item-action @(currentCategoryId == cate.Id ? "active" : "")">
                    @cate.Name
                </a>
            }
        </div>
    </div>

    <div class="col-md-9">
        <h3>Danh sách sản phẩm</h3>
        <div class="row">
            @if (!products.Any())
            {
                <p>Không có sản phẩm nào trong danh mục này.</p>
            }
            @foreach (var item in products)
            {
                <div class="col-md-4 mb-4">
                    <div class="thumbnail">
                        <img src="@item.Image" alt="@item.Name"
                             style="width:100%; height:200px; object-fit:cover; border-radius:6px;">
                        <div class="caption">
                            <h5>@item.Name</h5>
                            <p>
                                <del class="text-muted">Giá: @item.Price.ToString("N0")</del>
                                <strong class="text-danger"> Giá: @item.SalePrice.ToString("N0")</strong>
                            </p>
                            <a asp-route="product-detail" asp-route-id="@item.Id" class="btn btn-success btn-block">
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
