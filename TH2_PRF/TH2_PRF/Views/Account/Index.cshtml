@{
    ViewData["Title"] ="Index";
}
<div class="row">
    @foreach (var item in ViewBag.Accounts)
    {
        <div class="col-md-4">
            <div class="thumbnail">
                <img src="@item.Avatar" alt="" style="width:100%; height:250px; object-fit:cover; border-radius:6px;">
                <div class="caption">
                    <h3>@item.Name</h3>
                    <p>
                        @item.Bio
                    </p>
                    <p>
                        <a asp-route="profile" asp-route-id="@item.Id" class="btn btn-success btn-block">Profile</a>
                    </p>
                </div>
            </div>
        </div>
    }
</div>