@model DBFirstApp.Models.Learner

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Learner</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">LastName</dt>
        <dd class="col-sm-10">@Model.LastName</dd>
        <dt class="col-sm-2">FirstMidName</dt>
        <dd class="col-sm-10">@Model.FirstMidName</dd>
        <dt class="col-sm-2">EnrollmentDate</dt>
        <dd class="col-sm-10">@Model.EnrollmentDate</dd>
        <dt class="col-sm-2">Major</dt>
        <dd class="col-sm-10">@Model.Major?.MajorName</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.LearnerId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
