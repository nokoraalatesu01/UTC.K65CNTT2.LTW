@{
    ViewData["Title"] = "Add Student";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}
@model TH_Lab01_QLSV.Models.Student
@using TH_Lab01_QLSV.Models

<div class="container">
    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-controller="Student" asp-action="Create" method="post" enctype="multipart/form-data" class="mt-3">
        <div class="form-group row mt-2">
            <label class="col-sm-2 col-form-label">Ảnh đại diện</label>
            <div class="col-sm-10">
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Name" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Email" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Password" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Password" type="password" class="form-control" placeholder="Mật khẩu" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Branch" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <select asp-for="Branch" asp-items="Html.GetEnumSelectList<Branch>()" class="form-select">
                    <option value="">-- Chọn ngành --</option>
                </select>
                <span asp-validation-for="Branch" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <div class="form-check">
                    <input asp-for="IsRegular" class="form-check-input" />
                    <label asp-for="IsRegular" class="form-check-label">Chính quy</label>
                </div>
            </div>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="DateOfBorth" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="DateOfBorth" class="form-control" />
                <span asp-validation-for="DateOfBorth" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Gender" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                @foreach (var gender in Enum.GetValues<Gender>())
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="Gender" value="@gender" id="Gender@(gender)" />
                        <label class="form-check-label" for="Gender@(gender)">@(gender == Gender.Male ? "Nam" : "Nữ")</label>
                    </div>
                }
                <br />
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Mark" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="Mark" type="number" step="0.1" class="form-control" placeholder="Điểm (0 - 10)" />
                <span asp-validation-for="Mark" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Address" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-3">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}