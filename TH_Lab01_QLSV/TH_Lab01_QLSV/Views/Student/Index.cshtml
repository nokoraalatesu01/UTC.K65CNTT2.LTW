@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
}
@model IEnumerable<TH_Lab01_QLSV.Models.Student>

@* Có 3 cách tạo link tới form thêm mới (mỗi lần chỉ bật 1 cách, các cách còn lại để trong comment) *@
@* Cách 1 - HTML thuần:  <a href="/Admin/Student/Add" class="btn btn-primary mb-3">Create Student</a> *@
@* Cách 2 - asp-action:  <a asp-action="Create" class="btn btn-primary mb-3">Create Student</a> *@
@* Cách 3 - asp-route (gọi route theo tên "StudentAdd" đặt trong controller): *@
<a asp-route="StudentAdd" class="btn btn-primary mb-3">Create Student</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Ảnh</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>
                    @if (!string.IsNullOrEmpty(s.ImagePath))
                    {
                        <img src="@Url.Content("~/" + s.ImagePath)" alt="Ảnh sinh viên"
                             style="width:70px;height:70px;object-fit:cover;" />
                    }
                </td>
                <td>@s.Name</td>
                <td>@s.DateOfBorth.ToString("dd/MM/yyyy")</td>
                <td>
                    @{
                        string str = "";
                        switch (s.Branch)
                        {
                            case Branch.IT:
                                str = "CNTT";
                                break;
                            case Branch.BE:
                                str = "Kinh tế";
                                break;
                            case Branch.CE:
                                str = "Công trình";
                                break;
                            case Branch.EE:
                                str = "Điện - Điện tử";
                                break;
                        }
                    }
                    @str
                </td>
                <td>@(s.Gender == null ? "" : (s.Gender == Gender.Male ? "Nam" : "Nữ"))</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@s.Address</td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        var table = document.querySelector("table");
        table.onclick = function onTableClick() {
            table.style = "background-color: yellow;"
        }
    </script>
}
